# Helga API Configuration
# Configuración del backend Helga (helgasys.com)
HELGA_BASE_URL=https://api.ukuxbox.helgasys.com
HELGA_CLIENT_ID=
HELGA_CLIENT_SECRET=
HELGA_APP_ID=
# Origin que Helga valida contra su whitelist (403 "Acceso denegado" si no está
# autorizado). Si se omite, se usa HELGA_BASE_URL. Al publicar el sitio, pedir a
# Helga que agregue el dominio de producción y setear esta variable.
HELGA_ORIGIN=

# Supabase Configuration
# Módulo nuevo: admin, login de usuarios y productos
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<publishable-or-anon-key>
